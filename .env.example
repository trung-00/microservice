# Sao chép file này thành .env:  cp .env.example .env   (Windows cmd: copy .env.example .env)
# Mẹo: chỉ dùng chữ và số trong mật khẩu để tránh lỗi khi ghép vào connection string.

# --- Database-per-Service: mỗi DB có user/password riêng ---
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass_123
CUSTOMER_DB_USER=customer_user
CUSTOMER_DB_PASSWORD=customer_pass_123
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass_123
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product_pass_123
SHIPMENT_DB_USER=shipment_user
SHIPMENT_DB_PASSWORD=shipment_pass_123

# --- Redis (API Gateway: cache + rate limiting) ---
REDIS_PASSWORD=redis_pass_123

# --- Dùng từ Bước 2 ---
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
ADMIN_PASSWORD=Admin123
